<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>lhm-helper</AssemblyName>
    <RootNamespace>ESP32Monitor.LhmHelper</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <!-- Framework-dependent Ring0 release. 0.9.4 is the last selected version
       before the PawnIO backend; never replace it with a self-contained modern
       .NET publication. -->
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
