#!/bin/sh
set -e
APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export APPDIR
# The Agent runs host tools, which must not inherit bundled GTK libraries.
env_keys='LD_LIBRARY_PATH XDG_DATA_DIRS GSETTINGS_SCHEMA_DIR GI_TYPELIB_PATH GIO_MODULE_DIR GTK_DATA_PREFIX GTK_THEME GTK_EXE_PREFIX GTK_PATH GDK_PIXBUF_MODULE_FILE WEBKIT_INJECTED_BUNDLE_PATH'
for key in $env_keys; do
  if value=$(printenv "$key"); then
    export "ESP32_APPIMAGE_SAVED_$key=$value"
  fi
done
export XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
. "$APPDIR/apprun-hooks/linuxdeploy-plugin-gtk.sh"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
webkit_dir=$(cat "$APPDIR/usr/share/esp32-monitor/webkit-helper-dir")
webkit_name=$(basename "$webkit_dir")
export WEBKIT_INJECTED_BUNDLE_PATH="$APPDIR/usr/lib/$webkit_name/injected-bundle"
if command -v ldd >/dev/null 2>&1; then
  failed=0
  details=
  for binary in "$APPDIR/usr/bin/monitor-client" \
    "$APPDIR/usr/lib/$webkit_name/WebKitWebProcess" \
    "$APPDIR/usr/lib/$webkit_name/WebKitNetworkProcess" \
    "$WEBKIT_INJECTED_BUNDLE_PATH/libwebkitgtkinjectedbundle.so"; do
    status=0
    output=$(LC_ALL=C ldd "$binary" 2>&1) || status=$?
    missing=$(printf '%s\n' "$output" | grep -F 'not found' || :)
    if [ "$status" -ne 0 ] || [ -n "$missing" ]; then
      if [ "$status" -ne 0 ]; then
        missing=$output
      fi
      message="ESP32 Monitor: dependency check failed for $binary
$missing"
      printf '\n%s\n' "$message" >&2
      details="$details
$message
"
      failed=1
    fi
  done
  if [ "$failed" -ne 0 ]; then
    hint='Install missing system libraries or use a compatible distribution. If a bundled library is missing, re-download the AppImage. See the Linux README.'
    printf '\n%s\n' "$hint" >&2
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
      (
        for key in $env_keys; do
          if value=$(printenv "ESP32_APPIMAGE_SAVED_$key"); then
            export "$key=$value"
          else
            unset "$key"
          fi
        done
        if command -v zenity >/dev/null 2>&1; then
          zenity --error --no-markup --title='ESP32 Monitor' --text="$details
$hint" 2>/dev/null || :
        elif command -v kdialog >/dev/null 2>&1; then
          kdialog --title 'ESP32 Monitor' --error "$details
$hint" 2>/dev/null || :
        fi
      )
    fi
    exit 1
  fi
else
  printf 'ESP32 Monitor: ldd is unavailable; library dependencies cannot be checked before launch.\n' >&2
fi
# WebKit's relocated helper paths are relative to this directory.
cd "$APPDIR/usr/lib"
exec "$APPDIR/usr/bin/monitor-client" "$@"
