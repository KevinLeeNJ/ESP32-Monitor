#include "version.h"

// Compile from client/ with:
//   windres -I assets/icons -I packaging/windows/resources \
//     packaging/windows/resources/monitor-client.rc -O coff \
//     -o cmd/monitor-client/rsrc_windows_amd64.syso
// Icon group ID 3 matches the resource Wails loads for window/tray defaults.
3 ICON "app-icon.ico"

1 VERSIONINFO
FILEVERSION APP_VERSION
PRODUCTVERSION APP_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ESP32-Monitor"
            VALUE "FileDescription", "ESP32 Monitor Client"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "monitor-client"
            VALUE "OriginalFilename", "monitor-client.exe"
            VALUE "ProductName", "ESP32 Monitor"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
